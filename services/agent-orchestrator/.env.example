DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5441/agent_orchestrator
BIFROST_URL=http://localhost:4003
BIFROST_API_KEY=dummy
HTTP_HOST=0.0.0.0
HTTP_PORT=4002
# Browser CORS allowlist (comma-separated). The dashboard reaches this service
# through a server-side proxy, so a strict list is safe. Never set this to "*":
# the port is published on the host, so a wildcard lets any page a developer
# visits delete sessions and submit prompts that spend the model budget.
CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
SKILL_ROOTS=../../skills
VALKEY_URL=redis://localhost:6381/0
# Shared Valkey carrying the history:ingest bus. Defaults to VALKEY_URL above
# (this service's Valkey is the shared history bus by decision); set only to
# point history ingestion at a different Valkey.
# HISTORY_VALKEY_URL=redis://localhost:6381/0
ENABLED_PROVIDER_IDS=openai,claude,gemini,lmstudio,nvidia
WORKER_POLL_INTERVAL_SECONDS=0.2
# How long an idle SSE job-event stream waits on the Valkey live-event bus before
# re-reading the job's status from PostgreSQL. A published event ends the wait
# immediately, so this only bounds the rare case of a job going terminal without
# publishing — it is not a latency budget. Every tick costs one Valkey command,
# one TCP connection, one span and two database queries per open stream, so keep
# it in seconds, not milliseconds.
JOB_EVENT_STREAM_IDLE_BLOCK_SECONDS=15
WORKER_MAX_TOOL_ROUNDS=64
DEFAULT_JOB_MAX_ATTEMPTS=2
# How long an `ask_user` question waits for a human before it is closed as timed
# out (an absolute budget, must be positive), and how often the stored question
# is re-read while waiting. Both have working defaults and no credential.
ASK_USER_TIMEOUT_SECONDS=600
ASK_USER_POLL_INTERVAL_SECONDS=2
GAME_SERVICE_MCP_URL=http://localhost:4001/mcp/
PROVIDER_MODELS_CACHE_TTL_SECONDS=600
# Short per-provider timeout (seconds) for the Bifrost model-listing call so a
# provider missing an API key fails fast instead of stalling /providers for ~60s.
BIFROST_LIST_MODELS_TIMEOUT_SECONDS=8
# TTL (seconds, must be positive) for caching an unavailable provider so repeat
# /providers calls fast-fail instead of re-incurring the list-models timeout.
# After adding an API key, POST /providers/refresh (or GET /providers?refresh=true)
# clears the cache and forces an immediate re-probe.
BIFROST_UNAVAILABLE_CACHE_TTL_SECONDS=600

# --- Context management ------------------------------------------------------
# The fallback context window, used when the provider reports no context length
# for the session's model; the fraction of the window at which a job compacts
# its history, which is also the ceiling the compaction input is assembled
# under; and how much text one tool call's arguments or one tool result may
# contribute to that input before it is truncated with an explicit marker. The
# character budget applies to the compaction input only — a tool result replayed
# to the agent is never truncated. The last is the smallest replay worth
# summarizing, used only until a session has produced a summary to measure
# against: below it the trigger reports that fixed request cost rather than
# history reached the threshold, and makes no summarizing call. All four have
# working defaults.
CONTEXT_WINDOW_SIZE=128000
CONTEXT_COMPACTION_THRESHOLD=0.8
CONTEXT_COMPACTION_EVENT_CHAR_BUDGET=20000
CONTEXT_COMPACTION_MIN_REPLAY_TOKENS=4000

# --- OpenTelemetry -----------------------------------------------------------
# Docker Compose sets these for you (pointing at the otel-lgtm container); the
# values below are for a DIRECT local run against Dockerised infrastructure,
# where otel-lgtm publishes OTLP/HTTP on host port 4318 and Grafana on 3004.
# Uncommenting them is optional: with none set the service exports to
# http://localhost:4318 under its own service name anyway.
# Set OTEL_SDK_DISABLED=true to run with telemetry off entirely.
# OTEL_SERVICE_NAME=agent-orchestrator
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=dragncardsai
# OTEL_SDK_DISABLED=false
