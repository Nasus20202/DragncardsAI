DRAGNCARDS_HTTP_URL=http://localhost:4000
DRAGNCARDS_WS_URL=ws://localhost:4000/socket
VALKEY_URL=redis://localhost:6380/0
BOT_EMAIL=dev_user@example.com
BOT_PASSWORD=password
HTTP_HOST=0.0.0.0
HTTP_PORT="4001"
# History ingestion: emit post-action state/status events to the shared
# history:ingest bus. Set to false to disable emission entirely.
HISTORY_INGEST_ENABLED=true
# The shared Valkey carrying the history:ingest stream (the agent-orchestrator
# Valkey). This is intentionally separate from VALKEY_URL above, which is the
# game-service's own session-store Valkey.
HISTORY_VALKEY_URL=redis://localhost:6381/0
