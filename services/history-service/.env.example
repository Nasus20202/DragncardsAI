HISTORY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/history_service
VALKEY_URL=redis://localhost:6381/0
HTTP_HOST=0.0.0.0
HTTP_PORT=4004
# Shared ingestion stream contract (must match producers)
HISTORY_INGEST_STREAM=history:ingest
HISTORY_INGEST_CONSUMER_GROUP=history-service
# Empty -> a stable per-process consumer name is derived at startup
HISTORY_INGEST_CONSUMER_NAME=
# Approximate MAXLEN cap on the transport stream (durable copy lives in PostgreSQL)
HISTORY_INGEST_STREAM_MAXLEN=100000
# Emit a consumer-lag signal when the group falls this far behind
HISTORY_CONSUMER_LAG_ALERT_THRESHOLD=1000
# Snapshot cadence
SNAPSHOT_EVERY_N_EVENTS=25
SNAPSHOT_MAX_INTERVAL_SECONDS=300
# Largest history bundle POST /import will accept, in bytes (64 MiB)
HISTORY_IMPORT_MAX_BYTES=67108864
# Producer base URLs used by snapshotting and restore
GAME_SERVICE_BASE_URL=http://localhost:4001
AGENT_ORCHESTRATOR_BASE_URL=http://localhost:4002
