EVAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5443/eval_service
HISTORY_SERVICE_BASE_URL=http://localhost:4004
BIFROST_URL=http://localhost:4003
# Bifrost gateway auth token. This does NOT select a provider key -- the judge
# identity is pinned by EVAL_JUDGE_BIFROST_KEY_NAME below.
BIFROST_API_KEY=dummy
HTTP_HOST=0.0.0.0
HTTP_PORT=4005
# Judge model is REQUIRED with no default; the service refuses to evaluate when unset.
# The `provider/` prefix decides which provider (and so which judge key) is used.
# Examples: anthropic/claude-3-7-sonnet-latest, openrouter/anthropic/claude-sonnet-4
EVAL_JUDGE_MODEL=
# Optional provider hint recorded on verdicts (the model id prefix does the routing)
EVAL_JUDGE_PROVIDER=
# Name of the Bifrost key entry judge traffic is pinned to, sent as `x-bf-api-key`.
# Every provider in services/bifrost/config.json defines an `eval-judge` entry at
# weight 0.0 sourced from EVAL_JUDGE_<PROVIDER>_API_KEY, so ANY provider can judge
# under its own key and budget. Set to "" to deliberately fall back to the
# provider's game-playing key pool (logged at startup; readiness reports
# `judge_key.status: disabled`).
EVAL_JUDGE_BIFROST_KEY_NAME=eval-judge
# Recorded on every verdict so prompt/model changes are traceable. `eval-2`
# corrected round-boundary detection, so round/game verdicts tagged `eval-1`
# graded a span shifted by one event and are not comparable to newer ones.
EVALUATOR_VERSION=eval-2
# Retry / attempt limits per target
EVAL_MAX_ATTEMPTS=3
EVAL_RETRY_BACKOFF_SECONDS=0.5
# Concurrency caps on in-flight judge calls
EVAL_PER_GAME_CONCURRENCY=2
EVAL_GLOBAL_CONCURRENCY=8
# Per-evaluation judge token budget
EVAL_JUDGE_MAX_TOKENS=1024
# Backstop caps on the assembled judge INPUT so a large game stays inside a
# small-context model's window (truncation is logged). Recorded state is first
# PROJECTED to the board the playing agent saw, which on real games is a ~180x
# reduction, so these caps rarely bite; they still guard an unrecognised state
# shape. EVAL_JUDGE_MAX_ROUND_MOVES caps per-move blocks in a round prompt.
EVAL_JUDGE_MAX_STATE_CHARS=20000
EVAL_JUDGE_MAX_ROUND_MOVES=100
# Neighbouring-action window included with a per-move judge prompt, in agent
# moves either side of the one being graded. A window rather than the whole
# history: the prompt already carries the prior/resulting board, so replaying the
# full move list adds cost without signal -- but a single Marvel Champions play is
# 2-4 tool calls, so judging one call with no neighbours invites a confidently
# wrong verdict. Set _AFTER=0 to remove hindsight entirely.
EVAL_JUDGE_MOVE_CONTEXT_BEFORE=8
EVAL_JUDGE_MOVE_CONTEXT_AFTER=3
EVAL_JUDGE_MOVE_CONTEXT_REASONING_CHARS=400
# Skip evaluating actions that carry no strategic decision -- card/database
# searches, session plumbing, pre-game setup. Skipped targets are recorded as
# `skipped` WITH the reason, never as passed. Setting the list REPLACES the
# built-in taxonomy (see src/eval_service/judge/actions.py); anything not listed,
# including every unrecognised action, is evaluated.
EVAL_SKIP_NON_STRATEGIC_MOVES=true
# EVAL_NON_STRATEGIC_ACTIONS=attach_game,create_game,delete_game,get_game_state,get_session_actions,list_actions,list_card_providers,list_games,load_cards,load_prebuilt_deck,lookup_session_by_slug,multiple_double_sided_villains,search_cards_marvel_champions,search_prebuilt_sets_marvel_champions,set_player_count_action,unload_cards
# CORS allowlist (comma-separated). The dashboard uses a server-side proxy, so a
# strict allowlist does not break normal use.
EVAL_CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Judge call timeout (seconds)
EVAL_JUDGE_TIMEOUT_SECONDS=120
