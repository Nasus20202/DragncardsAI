BIFROST_API_KEY=dummy

# Provider credentials and endpoints (the GAME-PLAYING keys, weight 1.0).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENCODE_GO_API_KEY=

# Dedicated judge identity for the eval-service (distinct budget + attribution).
# Keep external; never commit a real value.
#
# Every provider in config.json carries a SECOND key entry named `eval-judge` at
# weight 0.0, sourced from the matching variable below. Weight 0.0 keeps it out of
# normal gameplay key selection; the eval-service pins judge traffic to it by
# sending the `x-bf-api-key: eval-judge` header (the `Authorization` bearer does
# NOT select a key). Set only the variable(s) for the provider(s) you actually
# judge with -- an entry whose variable is unset is treated as absent, so a judge
# call to that provider fails with a clear `no supported key found with name
# "eval-judge" for provider: <provider>` error rather than silently spending the
# game-playing key.
#
# To add a judge identity for a NEW provider: add an `eval-judge` key entry with
# `"weight": 0.0` and `"value": "env.EVAL_JUDGE_<PROVIDER>_API_KEY"` under that
# provider in config.json, add the variable here and to your `.env`, then restart
# Bifrost so it re-reads config.json.
EVAL_JUDGE_OPENAI_API_KEY=
EVAL_JUDGE_ANTHROPIC_API_KEY=
EVAL_JUDGE_GEMINI_API_KEY=
EVAL_JUDGE_MISTRAL_API_KEY=
EVAL_JUDGE_OPENROUTER_API_KEY=
EVAL_JUDGE_NVIDIA_API_KEY=
EVAL_JUDGE_OPENCODE_GO_API_KEY=
