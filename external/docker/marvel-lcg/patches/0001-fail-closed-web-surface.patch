 import re

 CATEGORY_NAME = "WEB"
+
+# The game-service client has a deliberately small HTTP surface.  Keep the
+# platform's developer, replay, puzzle, editor, and network-sharing surfaces
+# unavailable even when a later catch-all static route would otherwise find a
+# similarly named file under ./public.
+_FORBIDDEN_PATHS = frozenset({
+    "/debug",
+    "/debug.html",
+    "/exec",
+    "/execute",
+    "/cheat",
+    "/editor",
+    "/editor.html",
+    "/read_file",
+    "/replay",
+    "/replay.html",
+    "/load_replay",
+    "/load_replay_data",
+    "/save_replay_data",
+    "/save_local",
+    "/list_replay_files",
+    "/get_replay_json",
+    "/download_replay",
+    "/puzzle",
+    "/puzzle.html",
+    "/puzzle_editor",
+    "/puzzle_editor.html",
+    "/puzzle_test",
+    "/new_puzzle",
+    "/new_puzzle_replay",
+    "/load_puzzle",
+    "/list_puzzle_files",
+    "/list_puzzle_test_files",
+    "/new_debug",
+    "/new_game_lan",
+    "/new_game_online",
+})
+_FORBIDDEN_PATH_PREFIXES = ("/debug/", "/exec/", "/cheat/", "/editor/")
+_FORBIDDEN_STATIC_SUFFIXES = (
+    "/debug.html",
+    "/editor.html",
+    "/replay.html",
+    "/puzzle.html",
+    "/puzzle_editor.html",
+)
+_FORBIDDEN_QUERY_KEYS = frozenset({
+    "debug",
+    "cheat",
+    "show",
+    "replay",
+    "hot_seat",
+})
+
+
+@web.middleware
+async def _deny_forbidden_surface(request: web.Request, handler):
+    path = request.path.rstrip("/").lower() or "/"
+    if (
+        path in _FORBIDDEN_PATHS
+        or any(path.startswith(prefix) for prefix in _FORBIDDEN_PATH_PREFIXES)
+        or any(path.endswith(suffix) for suffix in _FORBIDDEN_STATIC_SUFFIXES)
+        or any(key.lower() in _FORBIDDEN_QUERY_KEYS for key in request.rel_url.query)
+    ):
+        return web.Response(status=404)
+    return await handler(request)

 SOUND_FOLDERS   = ConfigVariables.Folders('sound_folders', ["./assets/sounds/"])
 IMAGE_FOLDERS   = ConfigVariables.Folders('image_folders')
